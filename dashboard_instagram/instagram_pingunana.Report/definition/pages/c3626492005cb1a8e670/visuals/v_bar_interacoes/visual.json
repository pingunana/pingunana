{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.10.0/schema.json",
  "name": "v_bar_interacoes",
  "position": {
    "x": 650,
    "y": 150,
    "z": 7,
    "height": 380,
    "width": 550,
    "tabOrder": 7
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario"
                    }
                  },
                  "Property": "Data"
                }
              },
              "queryRef": "Calendario.Data",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Interacoes"
                    }
                  },
                  "Property": "Total Interacoes"
                }
              },
              "queryRef": "Interacoes.Total Interacoes"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Visitas_Cliques"
                    }
                  },
                  "Property": "Total Visitas ao Perfil"
                }
              },
              "queryRef": "Visitas_Cliques.Total Visitas ao Perfil"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}